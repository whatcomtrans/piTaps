# ============================================================
# piTaps Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ============================================================

# --- Fleet-wide config (lives in S3, not here) ------------------------------
# Fleet-wide settings (SERVER_URL, API_KEY) are stored in an S3 config file
# and fetched automatically at startup. Only the S3 coordinates and AWS
# credentials need to be on the Pi itself.
#
# See S3_CONFIG_SETUP.md for instructions on creating the bucket and file.

AWS_REGION=us-west-2
S3_CONFIG_BUCKET=your-pitaps-config-bucket
S3_CONFIG_KEY=pitaps-config.json          # optional — this is the default

# IAM credentials for a read-only user scoped to the config bucket.
AWS_ACCESS_KEY_ID=your-iam-access-key-id
AWS_SECRET_ACCESS_KEY=your-iam-secret-access-key

# --- App updates ------------------------------------------------------------
# Public GitHub repo — pulled on every reboot for automatic OTA updates.
GITHUB_REPO_URL=https://github.com/YOUR-ORG/piTaps.git

# --- Pi-specific (vehicle LAN) ----------------------------------------------
# These values are specific to each vehicle's network and stay on the Pi.
ROUTER_HOST=192.168.0.1
ROUTER_API_USERNAME=
ROUTER_API_PASSWORD=

# --- Card list sync ----------------------------------------------------------
# The Pi keeps the youth/student/staff card lists in sync with the taps API
# (full pull when no verified local state exists, then incremental deltas).
# Authenticates with the same API_KEY used for tap batches. Defaults shown;
# set CARD_LIST_SYNC_URL=off to disable. Both can also be set fleet-wide via
# CARD_LIST_SYNC_URL in the S3 config (which overrides the env value).
# CARD_LIST_SYNC_URL=https://api.taps.ridewta.com
# CARD_LIST_SYNC_INTERVAL_MS=60000

# --- Card validation lists (legacy static URLs) ------------------------------
# URLs to plain-text card number files (one number per line, # = comment).
# Use CARD_LIST_<NAME> — the name becomes the list_name in tap records.
# Requires modified Elatec firmware (see patch_abt.py).
# If configured (here or as CARD_LISTS in the S3 fleet config), these take
# precedence over card list sync — lists load once at startup, no deltas.
# CARD_LIST_YOUTH=https://example.com/cards/youth.txt
# CARD_LIST_STUDENT=https://example.com/cards/student.txt
# CARD_LIST_STAFF=https://example.com/cards/staff.txt

# --- Optional overrides -----------------------------------------------------
# Uncomment and set only if your feeds differ from the WTA defaults.
# GTFS_RT_VEHICLES_URL=https://bustracker.ridewta.com/gtfsrt/vehicles
# GTFS_RT_TRIPS_URL=https://bustracker.ridewta.com/gtfsrt/trips
# GTFS_STATIC_URL=https://github.com/whatcomtrans/publicwtadata/raw/master/GTFS/wta_gtfs_latest.zip
# GTFS_TIMEZONE=America/Los_Angeles
