# ============================================================
# piTaps Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ============================================================

# AWS API Gateway endpoint (required)
SERVER_URL=https://YOUR-ID.execute-api.us-west-2.amazonaws.com/prod/taps

# API authentication key (required)
API_KEY=your-api-key-here

# GitHub repository URL — used by the systemd service to pull updates on reboot
# Must be publicly accessible (no auth required)
GITHUB_REPO_URL=https://github.com/YOUR-ORG/piTaps.git

# Cradlepoint router IP on the vehicle LAN (default: 192.168.0.1)
ROUTER_HOST=192.168.0.1

# Cradlepoint router API credentials — leave blank if not required
ROUTER_API_USERNAME=
ROUTER_API_PASSWORD=

# GTFS-RT feed URLs (optional — defaults to WTA bustracker feeds)
GTFS_RT_VEHICLES_URL=https://bustracker.ridewta.com/gtfsrt/vehicles
GTFS_RT_TRIPS_URL=https://bustracker.ridewta.com/gtfsrt/trips
